# Copie para .env e ajuste os valores antes de subir o docker compose.

POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=5180

# Troque em produção (mínimo 32 caracteres)
JWT_SECRET=change-me-please-32-bytes-minimum-secret

# Salt para o hash do visitante (troque em produção)
VISITOR_SALT=change-me-visitor-salt

# Anonimiza o IP (zera o último octeto / últimos 80 bits) antes de geolocalizar e hashear
INGESTION_ANONYMIZE_IP=false

# Origem permitida para a API. Ex. com IP: http://SEU_IP:5180 ou * para liberar geral
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:[*],https://localhost:[*],http://127.0.0.1:[*],https://127.0.0.1:[*]

# Retenção dos eventos brutos em meses (144 = 12 anos, 12 = 1 ano)
RETENTION_EVENTS_MONTHS=144

# Caminho do banco GeoLite2 dentro do container. Coloque o arquivo em deploy/geoip/.
# Sem o arquivo, a geolocalização por IP fica desativada (país/cidade = vazios).
GEOIP_DB=/app/geoip/GeoLite2-City.mmdb

# Credenciais da MaxMind para baixar/atualizar a base automaticamente.
# Crie em https://www.maxmind.com (Account > Manage License Keys).
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
GEOIPUPDATE_EDITION_IDS=GeoLite2-City
# Intervalo de atualização em horas (usado pelo serviço do perfil "geoip").
GEOIPUPDATE_FREQUENCY=24
